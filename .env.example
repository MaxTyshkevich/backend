PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# SQLite persists users, sessions, cart items and guest merge records.
APP_DB_PATH=./data/shop.sqlite
# Production defaults to Secure cookies. Only disable for local HTTP Docker.
# COOKIE_SECURE=false
# API should be proxied through /api on the Shell origin (SameSite=Lax).
