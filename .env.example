PORT=3000
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175
# Prefer npm run db:setup: it generates a random local password in .env.
POSTGRES_PORT=5432
POSTGRES_PASSWORD=replace-with-your-local-password
DATABASE_URL=postgresql://microfronts:replace-with-your-local-password@localhost:5432/microfronts?schema=public
# Tests use a separate disposable PostgreSQL container on port 5434.
POSTGRES_TEST_PORT=5434
# Production defaults to Secure cookies. Only disable for local HTTP Docker.
# COOKIE_SECURE=false
# API should be proxied through /api on the Shell origin (SameSite=Lax).
